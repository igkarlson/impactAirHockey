{
  "expo": {
    "name": "Speedy Air Hockey",
    "slug": "speedy-air-hockey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sp.png",
    "scheme": "speedyairhockey",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b191e",
          "enableFullScreenImage_legacy": true,
          "image": "./assets/images/sp.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.varoldursun94.speedy-air-hockey"
    }
  }
}
